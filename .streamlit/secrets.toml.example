# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# All entries are optional.
NCBI_API_KEY = ""          # raises PubMed rate limit from 3 to 10 requests/s
NCBI_EMAIL = ""            # contact e-mail NCBI asks tool authors to send
PCT_LLM_PROVIDER = "none"  # none | anthropic | openai | gemini
ANTHROPIC_API_KEY = ""
OPENAI_API_KEY = ""
GEMINI_API_KEY = ""
PCT_OFFLINE_DEMO = "0"     # "1" starts the app in offline demo mode
